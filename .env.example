# FinView AI - exemplo de configuracao
#
# Copie este arquivo para `.env` e substitua somente os valores necessarios.
# Nunca envie a `.env` real para o Git e nunca reutilize os placeholders abaixo
# em producao. Variaveis marcadas como segredo devem ser obtidas no respectivo
# provedor e armazenadas apenas no ambiente local ou no painel do Render.

# -----------------------------------------------------------------------------
# Django
# -----------------------------------------------------------------------------

# SEGREDO OBRIGATORIO: usado pelo Django para assinar sessoes, cookies e tokens.
# Gere um valor longo, aleatorio e exclusivo para cada ambiente.
SECRET_KEY=replace-with-a-long-random-secret-key

# Use True apenas no desenvolvimento local. Em producao, mantenha False.
DEBUG=True

# Hosts aceitos, separados por virgula e sem http:// ou https://.
ALLOWED_HOSTS=localhost,127.0.0.1

# Origens completas autorizadas para requisicoes CSRF, separadas por virgula.
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Versao utilizada pelo ambiente de deploy do Render.
PYTHON_VERSION=3.14.3

# O Render fornece RENDER_EXTERNAL_HOSTNAME automaticamente. Nao e necessario
# definir essa variavel manualmente.

# -----------------------------------------------------------------------------
# Banco de dados
# -----------------------------------------------------------------------------

# CREDENCIAL: URL completa de conexao. O exemplo abaixo usa o SQLite local.
# Em producao, substitua pela URL privada fornecida pelo PostgreSQL/Render:
# postgresql://USUARIO:SENHA@HOST:PORTA/NOME_DO_BANCO
DATABASE_URL=sqlite:///db.sqlite3

# O projeto ainda aceita `external_database_url` e `internal_database_url` como
# alternativas legadas. Prefira DATABASE_URL e nao configure mais de uma delas.

# -----------------------------------------------------------------------------
# Groq / inteligencia artificial
# -----------------------------------------------------------------------------

# SEGREDO: chave criada no painel da Groq. Nao inclua aspas nem compartilhe.
GROQ_API_KEY=replace-with-your-groq-api-key

# Modelo usado para gerar os insights financeiros.
GROQ_MODEL=llama-3.3-70b-versatile

# Compatibilidade: `API_KEY` ainda e aceita quando GROQ_API_KEY nao estiver
# definida. `API_KEY_ANTIGA` nao e utilizada pelo codigo e pode ser removida.

# -----------------------------------------------------------------------------
# Recuperacao de senha por e-mail
# -----------------------------------------------------------------------------

# No desenvolvimento, o backend console imprime o e-mail e o link no terminal.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# Para enviar e-mails reais, use o backend abaixo e preencha as credenciais SMTP:
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# Normalmente a porta 587 usa TLS=True/SSL=False; a porta 465 costuma usar
# TLS=False/SSL=True. Nunca ative TLS e SSL ao mesmo tempo.
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_TIMEOUT=10
DEFAULT_FROM_EMAIL="FinView AI <no-reply@example.com>"

# Validade do link de redefinicao de senha, em segundos (3600 = 1 hora).
PASSWORD_RESET_TIMEOUT=3600

# -----------------------------------------------------------------------------
# HTTPS e arquivos estaticos
# -----------------------------------------------------------------------------

# Valores adequados para desenvolvimento local sem HTTPS.
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False
WHITENOISE_USE_FINDERS=True

# Em producao com HTTPS, use normalmente:
# DEBUG=False
# SECURE_SSL_REDIRECT=True
# SECURE_HSTS_SECONDS=31536000
# SECURE_HSTS_INCLUDE_SUBDOMAINS=True
# SECURE_HSTS_PRELOAD=True
